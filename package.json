{
  "name": "daymark-todo",
  "version": "1.5.3",
  "description": "A local-first desktop day planner with durable work reviews.",
  "main": "main.js",
  "author": "Daymark contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke": "electron . --smoke-test",
    "pack": "node scripts/build-macos.js --dir",
    "dist": "node scripts/build-macos.js"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.daymark.todo",
    "productName": "Daymark",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "README.md",
      "LICENSE",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Daymark ${version}"
    }
  }
}
